rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if
        (isAdmin()
          && request.resource.data.keys().hasOnly(['email', 'createdAt', 'via']))
        || (signedIn()
          && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/adminInvites/$(request.auth.token.email.lower()))
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.keys().hasOnly(['email', 'createdAt', 'via']));

      allow update: if isAdmin() && request.auth.uid == uid;
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /adminInvites/{email} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }

    match /regions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /incidents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tickets/{id} {
      allow read, write: if isAdmin();
    }

    match /team/{id} {
      allow read, write: if isAdmin();
    }
  }
}
