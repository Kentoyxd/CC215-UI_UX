rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // An admin is anyone who has a document in the "admins" collection (create it in the console).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lets the dashboard check "am I an admin?". Nobody can write here from the app.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Each admin's private settings / chat / preferences.
    match /users/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }

    // Public status page can read these. Only admins can change them.
    match /regions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /incidents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tickets stay private to admins.
    match /tickets/{id} {
      allow read, write: if isAdmin();
    }
  }
}
